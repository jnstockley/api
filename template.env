API_KEY="API_KEY"

DATABASE_URL=postgresql://<user>:<pass>@postgres:5432/<db>

TZ=America/Chicago
PGTZ=America/Chicago

# Nextcloud instance shared by Talk webhooks
NEXTCLOUD_URL=https://nextcloud.example.com

# Required for the /webhook/databasus endpoint
NEXTCLOUD_TALK_TOKEN=<talk-bot-conversation-token>
NEXTCLOUD_TALK_SECRET=<talk-bot-shared-secret>

# Required for the /webhook/beszel endpoint (separate Talk bot)
BESZEL_NEXTCLOUD_TALK_TOKEN=<beszel-bot-conversation-token>
BESZEL_NEXTCLOUD_TALK_SECRET=<beszel-bot-shared-secret>
